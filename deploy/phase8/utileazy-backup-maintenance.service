[Unit]
Description=Apply retention and verify the Utileasy backup repository
Wants=network-online.target
After=network-online.target
OnFailure=utileazy-alert@%n.service

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/utileazy-backup-maintenance
TimeoutStartSec=8h
UMask=0077
Nice=15
IOSchedulingClass=best-effort
IOSchedulingPriority=7
CacheDirectory=utileazy-restic
CacheDirectoryMode=0700
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
ProtectControlGroups=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
RestrictSUIDSGID=yes
ReadWritePaths=/var/cache/utileazy-restic /run/lock
