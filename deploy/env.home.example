# Copie este arquivo para .env na raiz do projeto e substitua os placeholders.
# Este perfil pressupõe acesso público por HTTPS; não use estes origins em HTTP local.
TAILSCALE_IP=
PUID=1000
PGID=1000
CLOUDFLARE_TUNNEL_TOKEN_FILE=./secrets/cloudflare-tunnel-token

DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=backend
DJANGO_CORS_ALLOWED_ORIGINS=https://utileazy.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://utileazy.example.com
DJANGO_SECURE_COOKIES=1

POSTGRES_DB=utilitydev
POSTGRES_USER=utilitydev
POSTGRES_PASSWORD=replace-with-a-strong-password
POSTGRES_HOST=db
POSTGRES_PORT=5432

ASSEMBLYAI_API_KEY=replace-with-a-new-rotated-key
TRANSCRIPTION_MAX_FILE_SIZE=99614720
TRANSCRIPTION_MAX_DURATION_SECONDS=7200
TRANSCRIPTION_MAX_PENDING_JOBS=10
TRANSCRIPTION_MAX_PENDING_PER_USER=2
TRANSCRIPTION_MAX_PENDING_PER_ANON=1
TRANSCRIPTION_DAILY_BUDGET_SECONDS=14400
ANONYMOUS_RESULT_TTL_HOURS=24
AUTHENTICATED_RESULT_TTL_DAYS=180
ANONYMOUS_COOKIE_NAME=utileazy_anon
ANON_IP_BURST_LIMIT=2
ANON_IP_DAILY_LIMIT=10
ANON_COOKIE_DAILY_LIMIT=3
ASSEMBLYAI_POLL_INTERVAL=10
TRANSCRIPTION_COMPLETION_MODE=polling
TRANSCRIPTION_RECONCILE_AFTER_SECONDS=300
DOCUMENT_MAX_FILE_SIZE=52428800
DOCUMENT_MAX_PAGES=200
DOCUMENT_MAX_UNCOMPRESSED_SIZE=262144000
DOCUMENT_MAX_PENDING_JOBS=3
DOCUMENT_MAX_PENDING_PER_USER=1
DOCUMENT_MAX_PENDING_PER_ANON=1
DOCUMENT_CONVERSION_TIMEOUT_SECONDS=600
DOCUMENT_CONVERSION_MEMORY_LIMIT_MB=1536
PUBLIC_BASE_URL=https://utileazy.example.com
ASSEMBLYAI_WEBHOOK_SECRET=replace-with-a-long-random-secret

TURNSTILE_ENABLED=1
TURNSTILE_SITE_KEY=replace-with-the-production-site-key
TURNSTILE_SECRET_KEY=replace-with-the-production-secret-key
TURNSTILE_EXPECTED_HOSTNAME=utileazy.example.com
TURNSTILE_EXPECTED_ACTION=anonymous_transcription
DOCUMENT_TURNSTILE_EXPECTED_ACTION=anonymous_document_conversion

MEDIA_STORAGE_BACKEND=filesystem
S3_ENDPOINT_URL=
S3_BUCKET_NAME=
S3_REGION=
S3_ACCESS_KEY=
S3_SECRET_KEY=

CELERY_WORKER_POOL=solo
CELERY_WORKER_CONCURRENCY=1
CELERY_WORKER_QUEUES=media,provider,documents,maintenance
CELERY_MAX_TASKS_PER_CHILD=50

PUBLIC_DOMAIN=utileazy.example.com
VPS_MEDIA_CONCURRENCY=1
VPS_PROVIDER_CONCURRENCY=2
VPS_DOCUMENT_CONCURRENCY=1
