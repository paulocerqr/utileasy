#!/bin/sh
set -eu

IPTABLES_BIN="${IPTABLES_BIN:-/usr/sbin/iptables}"
LAN_CIDR="${LAN_CIDR:-192.168.1.0/24}"
DOCKER_SUBNETS="${DOCKER_SUBNETS:-172.18.0.0/16 172.19.0.0/16}"
CHAIN="DOCKER-USER"

if [ ! -x "$IPTABLES_BIN" ]; then
    echo "iptables não encontrado em $IPTABLES_BIN" >&2
    exit 1
fi

if ! "$IPTABLES_BIN" -w 5 -n -L "$CHAIN" >/dev/null 2>&1; then
    echo "A cadeia $CHAIN não está disponível" >&2
    exit 1
fi

for source in $DOCKER_SUBNETS; do
    if ! "$IPTABLES_BIN" -w 5 -C "$CHAIN" \
        -s "$source" \
        -d "$LAN_CIDR" \
        -j REJECT \
        --reject-with icmp-admin-prohibited \
        2>/dev/null
    then
        "$IPTABLES_BIN" -w 5 -I "$CHAIN" 1 \
            -s "$source" \
            -d "$LAN_CIDR" \
            -j REJECT \
            --reject-with icmp-admin-prohibited
    fi
done
